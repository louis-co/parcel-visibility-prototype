[Unit]
Description=BLE Beacon Uplink to Convex /ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=louis
Group=louis
WorkingDirectory=/opt/parcel-tracker-pi/runtime
EnvironmentFile=-/etc/default/ble_uplink
Environment=INGEST_URL=https://your-deployment.convex.site/ingest
Environment=TRACKER_ID=pi-5-gateway-01
Environment=CONTRACT_VERSION=1.0.0
Environment=BLE_COMPANY_ID=65535
Environment=BLE_COOLDOWN_SECONDS=60
ExecStart=/usr/bin/python3 /opt/parcel-tracker-pi/runtime/ble_uplink.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
