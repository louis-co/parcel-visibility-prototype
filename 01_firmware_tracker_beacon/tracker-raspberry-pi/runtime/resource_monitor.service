[Unit]
Description=Parcel Tracker Resource and Error Monitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/default/resource_monitor
ExecStart=/usr/local/bin/resource_monitor.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
