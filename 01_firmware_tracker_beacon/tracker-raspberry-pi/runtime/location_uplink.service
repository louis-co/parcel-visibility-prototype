[Unit]
Description=Parcel Tracker Location Uplink (GNSS + SIM7670 LBS fallback)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=louis
Group=louis
WorkingDirectory=/opt/parcel-tracker-pi/runtime
StateDirectory=parcel-tracker
EnvironmentFile=-/etc/default/location_uplink
Environment=INGEST_URL=https://YOUR-DEPLOYMENT.convex.site/ingest
Environment=TRACKER_ID=pi-001
Environment=CONTRACT_VERSION=1.0.0
Environment=LOCATION_INTERVAL_SEC=30
Environment=HEARTBEAT_INTERVAL_SEC=30
Environment=LBS_ENABLED=true
Environment=LBS_MAX_ACCURACY_M=1000
Environment=LBS_QUERY_TIMEOUT_SEC=4
Environment=AT_PORT=/dev/serial/by-id/usb-QualComm_QualComm_Compo_000000000001-if06
Environment=QUEUE_DB_PATH=/var/lib/parcel-tracker/location_uplink.db
ExecStart=/usr/bin/python3 /opt/parcel-tracker-pi/runtime/location_uplink.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
