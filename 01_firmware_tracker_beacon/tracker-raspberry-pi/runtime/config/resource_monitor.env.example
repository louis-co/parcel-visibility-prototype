# Interval for host resource snapshots and error scrape windows.
MONITOR_INTERVAL_SEC=60

# Local rolling health log path.
MONITOR_LOG_FILE=/var/log/parcel-tracker/health.log

# State file storing last journal scrape timestamp.
MONITOR_STATE_FILE=/var/lib/parcel-tracker/resource_monitor.last_ts

# Critical units scanned for journal errors.
MONITOR_JOURNAL_UNITS=location_uplink.service ble_receiver.service rfid_uplink.service lte-init.service

# Max number of journal error lines appended per cycle.
MONITOR_MAX_JOURNAL_LINES=200
