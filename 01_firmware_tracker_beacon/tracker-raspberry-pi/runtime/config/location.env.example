# Convex ingest endpoint
INGEST_URL=https://YOUR-DEPLOYMENT.convex.site/ingest

# Tracker identity + contract
TRACKER_ID=pi-001
CONTRACT_VERSION=1.0.0

# Timing
LOCATION_INTERVAL_SEC=30
HEARTBEAT_INTERVAL_SEC=30

# SIM7670 AT port + serial
AT_PORT=/dev/serial/by-id/usb-QualComm_QualComm_Compo_000000000001-if06
AT_PORT_FALLBACKS=/dev/ttyACM2,/dev/ttyACM0
AT_BAUD=115200
AT_READ_WINDOW_SEC=3

# Native LBS fallback controls
LBS_ENABLED=true
LBS_MAX_ACCURACY_M=1000
LBS_QUERY_TIMEOUT_SEC=4
LBS_ALLOW_ZERO_COORDS=false

# No-fix GNSS recovery controls
# Re-assert GNSS power every N consecutive no-fix cycles (0 disables)
NOFIX_GNSS_POWER_REASSERT_EVERY=2
# Trigger a GNSS cold-start after N consecutive no-fix cycles (0 disables)
NOFIX_COLDSTART_AFTER=3

# Durable outbox queue
QUEUE_DB_PATH=/var/lib/parcel-tracker/location_uplink.db
MAX_FLUSH_BATCH=25
MAX_BACKOFF_SEC=300

# Optional bearer token for ingest
# INGEST_AUTH_TOKEN=replace-me
